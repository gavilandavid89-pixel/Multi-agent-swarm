PORT=3100
NODE_ENV=development
WORKER_SHARED_SECRET=replace-with-a-long-random-secret
# Persistent PostgreSQL for jobs, checkpoints, token usage and encrypted artifacts.
DATABASE_URL=postgresql://postgres:password@localhost:5432/swarm_jobs
HISTORY_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
DATABASE_PATH=./data/swarm.sqlite

# Independent account database; set the same URL and encryption key on the bridge.
SWARM_DATABASE_URL=postgresql://postgres:password@localhost:5432/swarm_accounts
SWARM_API_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Legacy provider variables are imported once into the initial admin account at login.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional legacy compatible-provider configuration; API secrets belong in separate env vars.
AI_FALLBACK_PROVIDERS=[]

# Per-batch budget and output cap.
MAX_TASK_TOKENS=50000
MAX_OUTPUT_TOKENS_PER_CALL=6000
MAX_CONTINUATION_CALLS=4
