PORT=3100
NODE_ENV=development
WORKER_SHARED_SECRET=replace-with-a-long-random-secret
GROQ_API_KEY=replace-with-your-groq-api-key
GEMINI_API_KEY=
# Shared by bridge and worker; point both to the same account database.
SWARM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swarm_accounts?sslmode=disable
# Must exactly match the key in apps/bridge/.env.
SWARM_API_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
# Persistent task/history database used by the worker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swarm_history?sslmode=disable
HISTORY_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
DATABASE_PATH=./data/swarm.sqlite

# Presupuesto acumulado por tanda y máximo de salida por respuesta del modelo
MAX_TASK_TOKENS=1000000
MAX_OUTPUT_TOKENS_PER_CALL=6000

# Proveedores adicionales compatibles con OpenAI Chat Completions.
# Define las claves indicadas en apiKeyEnv como variables de entorno independientes.
# Ejemplo:
# AI_FALLBACK_PROVIDERS=[{"name":"Proveedor alternativo","baseUrl":"https://api.example.com/v1","apiKeyEnv":"ALT_API_KEY","models":{"reasoning":"modelo-razonamiento","coding":"modelo-codigo","validation":"modelo-validador"}}]
AI_FALLBACK_PROVIDERS=[]
