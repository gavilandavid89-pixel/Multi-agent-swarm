PORT=3000
NODE_ENV=development
WORKER_BASE_URL=http://localhost:3100
WORKER_SHARED_SECRET=replace-with-a-long-random-secret
# Used only as the initial admin password when SWARM_DATABASE_URL has no users yet.
APP_ACCESS_KEY=replace-with-another-long-random-secret
# Independent PostgreSQL database for accounts, API credentials and task ownership.
SWARM_DATABASE_URL=postgresql://postgres:password@localhost:5432/swarm_accounts
# Generate with: openssl rand -hex 32. Set the SAME value in the worker.
SWARM_API_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
