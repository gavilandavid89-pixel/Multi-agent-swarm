{
  "schemaVersion": 1,
  "reportId": "<uuid>",
  "occurredAt": "<ISO-8601-with-timezone>",
  "service": "worker",
  "environment": "production",
  "severity": "error",
  "category": "runtime",
  "summary": "<one-sentence-summary>",
  "error": {
    "name": "<error-name>",
    "message": "<redacted-original-message>",
    "stack": "<optional-short-redacted-stack>"
  },
  "correlation": {
    "taskId": "<non-secret-task-id-or-empty>",
    "checkpoint": "<checkpoint-or-empty>",
    "requestId": "<request-id-or-empty>",
    "traceId": "<trace-id-or-empty>"
  },
  "operation": {
    "name": "<operation-name>",
    "attempt": 1,
    "elapsedMs": 0,
    "retryable": false,
    "idempotencyKey": "<non-secret-key-or-empty>"
  },
  "reproduction": {
    "steps": [
      "<minimal-step-1>"
    ],
    "expected": "<expected-behavior>",
    "actual": "<actual-behavior>"
  },
  "runtime": {
    "coldStartSuspected": false,
    "serviceReady": false,
    "httpStatus": 500
  },
  "evidence": {
    "logReferences": [
      "<safe-log-reference>"
    ],
    "artifactReferences": []
  }
}
